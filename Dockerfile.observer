FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS build
WORKDIR /app
COPY src/observability/front-observer/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY src/observability/front-observer/ ./
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_BASE_PATH=/observe/
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build -- --base=${VITE_BASE_PATH}

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY src/observability/front-observer/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html/observe
EXPOSE 8080
