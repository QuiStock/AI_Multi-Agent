OPENAI_API_KEY=coloque-sua-chave-aqui
GEMINI_API_KEY=coloque-sua-chave-aqui
TYPESAFE_API_KEY=coloque-sua-chave-aqui
TYPESAFE_API_BASE_URL=https://api.typesafe.ai
TYPESAFE_JEV_MODEL=jev-1.13.0
TYPESAFE_JEV_TIMEOUT_SECONDS=5
AUTH_JWT_ALGORITHM=RS256
AUTH_JWT_ISSUER=https://auth.example.com
AUTH_JWT_AUDIENCE=quistock-api
AUTH_JWT_JWK_SET_URI=http://localhost:8090/.well-known/jwks.json
# JWT_SECRET é somente para desenvolvimento com AUTH_JWT_ALGORITHM=HS256.
JWT_SECRET=
# Segredo próprio da sessão de observabilidade (mínimo 32 caracteres).
OBSERVABILITY_SESSION_SECRET=
OBSERVABILITY_FRONTEND_ORIGIN=https://quistock-ai-observability.onrender.com
GROQ_API_KEY=coloque-sua-chave-aqui
# POSTGRES_DSN deve usar uma credencial exclusiva somente de leitura.
# Ambiente de execução: development, qa ou production.
APP_ENVIRONMENT=development
POSTGRES_DSN=
OPENAI_MODEL=gpt-6-luna
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_TIER=free
# OpenAI: chat, agentes e resumos/títulos de conversa.
# Google Gemini: somente embeddings do FAQ e da memória.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=quistock
QDRANT_URL=https://seu-cluster.qdrant.io
QDRANT_API_KEY=coloque-sua-chave-aqui
REDIS_URL=redis://localhost:6379/0
SUMMARY_QUEUE_STREAM=quistock:conversation-summary
SUMMARY_QUEUE_GROUP=summary-workers
SUMMARY_JOB_MAX_ATTEMPTS=5
SUMMARY_RECONCILIATION_INTERVAL_SECONDS=60
MEMORY_CONVERSATIONS_COLLECTION=conversations
MEMORY_SUMMARY_JOBS_COLLECTION=conversation_summary_jobs
MEMORY_SUMMARY_LOCKS_COLLECTION=conversation_summary_locks

# FAQ RAG (opcionais — usam os defaults abaixo se não forem definidas)
# FAQ_DATA_DIR=./src/data
# FAQ_DOCS_DIR=./src/data/docs  # contém shared/, employee/ e manager/
# FAQ_VECTORSTORE_COLLECTION=faq_v2
# FAQ_VECTORSTORE_DIR=./src/data/vectorstore
# FAQ_METADATA_FILE=./src/data/metadata.json
# FAQ_CHUNK_SIZE=1000
# FAQ_CHUNK_OVERLAP=200
# FAQ_RETRIEVAL_K=4
# Relevância mínima entre 0 e 1. Ajuste-a usando casos reais de avaliação.
# FAQ_RETRIEVAL_MIN_RELEVANCE=0.30
