GEMINI_API_KEY=coloque-sua-chave-aqui
GROQ_API_KEY=coloque-sua-chave-aqui
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_TITLE_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.95
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=quistock
REDIS_URL=redis://localhost:6379/0
SUMMARY_QUEUE_STREAM=quistock:conversation-summary
SUMMARY_QUEUE_GROUP=summary-workers
SUMMARY_JOB_MAX_ATTEMPTS=3

# FAQ RAG (opcionais — usam os defaults abaixo se não forem definidas)
